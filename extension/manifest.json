{
  "manifest_version": 3,
  "name": "S-Gyver Omnichannel & Shopee Warehouse Assistant",
  "version": "1.1.1",
  "description": "ดึงออเดอร์ BigSeller และซิงค์คลังสินค้าจาก Shopee Seller Centre เข้าสู่ S-Gyver ในคลิกเดียว",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.bigseller.com/*",
    "*://seller.shopee.co.th/*",
    "*://*.shopee.co.th/*",
    "*://shopee.co.th/*",
    "*://seller.th.shopee.cn/*",
    "https://igiihteeeprpcxxlldkd.supabase.co/*",
    "https://s-gyver.github.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "file:///*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sgyver-assistant@s-gyver.github.io",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bigseller.com/*"
      ],
      "js": ["content_bigseller.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://seller.shopee.co.th/*",
        "*://seller.th.shopee.cn/*"
      ],
      "js": ["content_shopee_seller.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://shopee.co.th/*",
        "*://*.shopee.co.th/*"
      ],
      "js": ["content_shopee_scraper.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://s-gyver.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": ["content_sgyver.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "S-Gyver Assistant",
    "default_popup": "popup.html"
  }
}
